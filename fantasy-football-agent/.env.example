# ESPN league identifiers
ESPN_LEAGUE_ID=123456
# ESPN "year" is the season's starting calendar year (e.g. the 2025-26 season is 2025).
# Leave unset to auto-detect from the current date.
ESPN_SEASON_YEAR=
# Your team's numeric team_id within the league (see README for how to find it).
ESPN_TEAM_ID=1

# Private league auth cookies (see README "Getting your ESPN cookies").
ESPN_S2=
ESPN_SWID=

# Optional: where to write the generated report. Defaults to reports/latest.md
REPORT_OUTPUT=
